class Solution {
public:
    int subarraySum(vector<int>& nums, int k) {
        int ans=0;
        int sum =0;
        int n = nums.size();

        unordered_map<int,int> mp; //{presum, sum}
        mp[0]=1;
        for(int i=0; i<n;i++)
        {
            sum = sum+nums[i];
            int needed = sum - k;
            ans+= mp[needed];
            mp[sum]+=1;
        }
        return ans;
    }
};
